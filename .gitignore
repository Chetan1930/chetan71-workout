# This project uses bun (bun.lock) — do not commit an npm/yarn/pnpm lockfile alongside it
package-lock.json
yarn.lock
pnpm-lock.yaml

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Local Supabase dev stack (generated by `supabase start`, includes local-only demo secrets)
supabase/.temp/
supabase/.branches/

# Environment variables (never commit secrets/keys)
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
